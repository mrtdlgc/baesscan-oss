# =============================================================================
# baes scan OSS — self-hosted configuration
# =============================================================================
#
# This is the alpha self-hosted/BYOK edition. You supply the Telegram bot
# token, RPC endpoints, optional Blockscout key, optional R2 bucket, and the
# database file. The hosted baesscan.com product is the easier path if you
# do not want to pay for RPCs, run backfills, or maintain a clean index.
#
# Read docs/self-hosting.md, docs/rpc-costs.md, and docs/read-only-security.md
# before enabling expensive features like wallet-PnL, the market archive, or
# active pool discovery.
#
# =============================================================================
# Required: Telegram
# =============================================================================

# Create a bot with @BotFather and paste the token here. Never commit the
# real value. Anyone with this token can impersonate your bot.
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_MODE=polling
# Railway bot-first deployments should use webhook once public networking is on.
# TELEGRAM_WEBHOOK_URL can be blank when PUBLIC_BASE_URL or RAILWAY_PUBLIC_DOMAIN
# is available.
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Default deploy is intentionally single-chain to avoid surprise RPC egress.
# Add chains only when you have RPC capacity for them.
PRIMARY_CHAIN=base
ENABLED_CHAINS=base

# RPC URLs are comma-separated, primary first. The pool uses failover, not
# broadcast, so a healthy primary handles each call by itself.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/replace_me
BASE_RPC_URLS=
ETHEREUM_RPC_URLS=
BSC_RPC_URLS=
ARBITRUM_RPC_URLS=
OPTIMISM_RPC_URLS=
MONAD_RPC_URLS=
MEGAETH_RPC_URLS=
ROBINHOOD_RPC_URLS=
POLYGON_RPC_URLS=
AVALANCHE_RPC_URLS=
SOLANA_RPC_URLS=

# =============================================================================
# Multi-tenant / public deployment
# =============================================================================

BRAND_NAME=baes scan
PUBLIC_MODE=true
# Comma-separated Telegram user ids for owner commands and owner DM alerts.
OWNER_USER_IDS=
ADMIN_USER_IDS=
ALLOWED_CHAT_IDS=
MAX_CHATS=500
MAX_POOLS_PER_CHAT=25
SCAN_COOLDOWN_MS=15000

# =============================================================================
# Storage
# =============================================================================

STORAGE_BACKEND=auto
DATA_FILE=./data/state.db

# =============================================================================
# Chain / RPC behavior
# =============================================================================

# Optional per-chain PoolManager overrides. Defaults are in src/chains/registry.ts.
POOL_MANAGER_ADDRESS=
BASE_POOL_MANAGER_ADDRESS=
ETHEREUM_POOL_MANAGER_ADDRESS=
BSC_POOL_MANAGER_ADDRESS=
ARBITRUM_POOL_MANAGER_ADDRESS=
OPTIMISM_POOL_MANAGER_ADDRESS=
MONAD_POOL_MANAGER_ADDRESS=
MEGAETH_POOL_MANAGER_ADDRESS=
ROBINHOOD_POOL_MANAGER_ADDRESS=

# 30s is a safer Railway/free-tier default. Lower it only on paid RPC/VPS.
POLL_INTERVAL_MS=30000
RPC_CALL_TIMEOUT_MS=20000
# If Telegram getMe/long polling is temporarily unreachable on Railway, keep the
# process alive and retry bot.launch() instead of crash-looping the web app.
TELEGRAM_ENABLED=true
TELEGRAM_LAUNCH_RETRY_MS=10000
# 0 means retry forever. Set a small number for web-only Railway services that
# should stop trying Telegram after a few failed launches.
TELEGRAM_LAUNCH_MAX_RETRIES=0
CONFIRMATIONS=2
LOG_CHUNK_SIZE=500
# Hard-capped to 50000 in code. Token-based /watch and /scan require users to
# provide the token deployment block and only scan this bounded window.
POOL_SCAN_LOOKBACK_BLOCKS=50000
DEFAULT_BACKFILL_BLOCKS=5

# =============================================================================
# Web preview / mock chart
# =============================================================================

WEB_ENABLED=true
WEB_PORT=3000
# Optional fallback for direct-only operator pages such as /admin/copy-shadow.
WEB_ADMIN_PASSWORD=
# Set false to disable all intel routes, wallet-PnL materializers/indexers,
# copy-shadow simulation, and intel-only RPC/Blockscout work.
INTEL_ENABLED=true
# Set this when the host has public ingress and Telegram chart links should
# resolve to a public URL.
PUBLIC_BASE_URL=
MARKETS_ENABLED=false
MOCK_CHART_LOOKBACK_BLOCKS=250
GECKO_POOL_LOOKUP=true
# Railway/free-tier default: keep the live raw-RPC market scan short and use R2
# snapshots/archive for longer 24h windows. Set MARKET_LIVE_PROFILE=full only on
# a memory/RPC budget that can handle hot pools.
MARKET_LIVE_PROFILE=railway-free
BASE_TRENDING_LOOKBACK_BLOCKS=2700
ETHEREUM_TRENDING_LOOKBACK_BLOCKS=450
TRENDING_MAX_POOLS=8
TRENDING_CACHE_MS=45000
NEW_PAIRS_LOOKBACK_BLOCKS=7200
NEW_PAIRS_MAX_POOLS=24
NEW_PAIRS_CACHE_MS=30000
MARKET_DETAIL_LOOKBACK_BLOCKS=3600
MARKET_DETAIL_CACHE_MS=8000
SOLANA_SIGNATURE_LIMIT=20
SOLANA_TRANSACTION_LIMIT=10
SOLANA_RAW_TIMEOUT_MS=20000

# =============================================================================
# Cloudflare public market snapshots
# =============================================================================

# When enabled, the Railway/VPS app keeps doing raw RPC work but publishes
# compressed JSON snapshots to Cloudflare R2 for public Worker/edge reads.
MARKET_SNAPSHOTS_ENABLED=false
MARKET_SNAPSHOT_PREFIX=dex-data
MARKET_SNAPSHOT_CACHE_SECONDS=20
MARKET_HISTORY_RETENTION_DAYS=30
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional append-only swap-event archive. This persists a tracked pool registry
# from configured factory/PoolManager events, then writes compact swap log chunks
# to R2 under dex-data/{chain}/swaps/blocks/*.json.br.
MARKET_ARCHIVE_ENABLED=false
MARKET_ARCHIVE_CHAINS=base,ethereum
MARKET_ARCHIVE_INTERVAL_MS=120000
MARKET_ARCHIVE_FACTORY_LOOKBACK_BLOCKS=5000
MARKET_ARCHIVE_SWAP_LOOKBACK_BLOCKS=2000
MARKET_ARCHIVE_HEAD_LAG_BLOCKS=2
MARKET_ARCHIVE_PENDING_POOL_TTL_BLOCKS=43200
MARKET_ARCHIVE_LOG_FILTER_CONCURRENCY=3
MARKET_ARCHIVE_NORMALIZE_CONCURRENCY=16
# Speeds one-time archive backfills by skipping token name/totalSupply calls.
MARKET_ARCHIVE_FAST_TOKEN_METADATA=false
# 0 means scan every registered pool. Set a positive cap only as an emergency
# guard; capped scans are not complete coverage.
MARKET_ARCHIVE_MAX_POOLS_PER_TICK=0
# Stops one noisy factory range from growing the pool registry without bound.
# Applied per tracked factory so a noisy source does not starve later factories.
MARKET_ARCHIVE_MAX_FACTORY_DISCOVERIES=1000
# Optional quota-aware RPC scheduler for archive/backfill work only. Each entry is:
# label|url|rps=1|blocks=2000|weight=1. Live tracker/web scans still use *_RPC_URLS.
BASE_BACKFILL_RPC_PROVIDERS=
ETHEREUM_BACKFILL_RPC_PROVIDERS=
# Chunk compact swap archives by normalized trade rows. The old
# MARKET_ARCHIVE_CHUNK_LOG_LIMIT name is still accepted as a fallback.
MARKET_ARCHIVE_CHUNK_TRADE_LIMIT=5000

# =============================================================================
# Wallet PnL digest
# =============================================================================

# WARNING: wallet-PnL and historical backfills can be RPC-expensive.
# Start with one chain and small windows before enabling broad scans. Active
# pool discovery and token bootstrap also call Blockscout per scan tick;
# leave them off unless you have a paid Blockscout key or a generous quota.
#
# Separate Base-first DEX-trade PnL ledger. It stores normalized wallet trades
# locally for 3 days by default, computes realized PnL over the last 24h, and
# can post an hourly Telegram digest from the latest snapshot. Curve and
# Balancer pools are intentionally excluded from this wallet-PnL surface.
WALLET_PNL_ENABLED=false
WALLET_PNL_CHAIN=base
WALLET_PNL_RETENTION_DAYS=3
WALLET_PNL_WINDOW_HOURS=24
WALLET_PNL_BOOTSTRAP_HOURS=72
WALLET_PNL_SCAN_INTERVAL_MS=60000
WALLET_PNL_SNAPSHOT_INTERVAL_MS=300000
WALLET_PNL_ANALYTICS_INTERVAL_MS=900000
WALLET_PNL_NEW_TOKENS_INTERVAL_MS=300000
WALLET_PNL_PROFILE_REBUILDS=false
WALLET_PNL_HISTORICAL_PRECOMPUTE_INTERVAL_MS=3600000
WALLET_PNL_HISTORICAL_PRECOMPUTE_TOKEN_LIMIT=2
WALLET_PNL_HISTORICAL_PRECOMPUTE_WALLET_LIMIT=25
WALLET_PNL_POST_INTERVAL_MS=3600000
WALLET_PNL_POST_CHAT_ID=
WALLET_PNL_POST_THREAD_ID=
WALLET_PNL_MAX_BLOCKS_PER_TICK=1000
# Scan selection is narrower than the durable pool registry: seed pools first,
# then pools with recent retained trades, then Blockscout/token-bootstrap pools,
# then other non-v4 factory pools. 0 means scan every eligible registered pool.
WALLET_PNL_MAX_POOLS_PER_TICK=5000
# Optional comma-separated subset of seed,factory,blockscout. Blank = all three.
WALLET_PNL_SCAN_POOL_SOURCES=
WALLET_PNL_BLOCK_LOOKUP_CONCURRENCY=8
WALLET_PNL_TX_LOOKUP_CONCURRENCY=16
WALLET_PNL_METADATA_TIMEOUT_MS=10000
WALLET_PNL_TX_LOOKUP_TIMEOUT_MS=15000
WALLET_PNL_HEAD_LAG_BLOCKS=2
WALLET_PNL_SNAPSHOT_LIMIT=1000
WALLET_PNL_MIN_PROFIT_USD=0
WALLET_PNL_SEED_POOL_LIMIT=50
WALLET_PNL_MAX_FACTORY_DISCOVERIES=1000
# The hourly digest waits until the indexer is within this many blocks of head.
WALLET_PNL_MAX_POST_LAG_BLOCKS=3600
# Uses Blockscout during each wallet-PnL tick to detect active v4 pool ids that
# swapped in the scanned range but are missing from wallet_pnl_pools. Disabled
# by default in the OSS edition because it requires a Blockscout key with quota
# headroom and adds steady RPC pressure.
WALLET_PNL_ACTIVE_POOL_DISCOVERY_ENABLED=false
WALLET_PNL_ACTIVE_POOL_DISCOVERY_MAX_POOLS=25
# When a token page has no wallet-PnL trades, Blockscout can discover older
# pools for that token, persist them in wallet_pnl_pools, and replay recent
# swaps. Off by default in the OSS edition for the same reason.
WALLET_PNL_TOKEN_BOOTSTRAP_ENABLED=false
WALLET_PNL_TOKEN_BOOTSTRAP_DISCOVERY_DAYS=30
WALLET_PNL_TOKEN_BOOTSTRAP_REPLAY_HOURS=24
WALLET_PNL_TOKEN_BOOTSTRAP_MAX_POOLS=25
# Separate pressure valves for other Blockscout-backed wallet-PnL work. Blank
# means "on when BLOCKSCOUT_API_KEY is set" (token bootstrap inherits
# WALLET_PNL_TOKEN_BOOTSTRAP_ENABLED). Keep token bootstrap and historical
# backfill off during catch-up until the scan cursor is close to chain head.
WALLET_PNL_BLOCKSCOUT_TOKEN_BOOTSTRAP_ENABLED=
WALLET_PNL_BLOCKSCOUT_CREATOR_LOOKUP_ENABLED=
WALLET_PNL_BLOCKSCOUT_HISTORICAL_BACKFILL_ENABLED=
# Optional: comma-separated factory/launcher contracts whose tokens should be
# flagged and excluded from the signal leaderboard. The old
# WALLET_PNL_DENIED_TOKEN_CREATORS name is still accepted as an alias.
WALLET_PNL_DENIED_TOKEN_FACTORY_CONTRACTS=

# =============================================================================
# Copy shadow simulation
# =============================================================================

# Paper-only copy-trading simulator. These envs are startup defaults; the
# direct-only /admin/copy-shadow page can enable and tune the persisted config
# after deploy. It never signs or submits transactions.
COPY_SHADOW_ENABLED=false
COPY_SHADOW_CHAIN=base
COPY_SHADOW_WALLETS=
COPY_SHADOW_INTERVAL_MS=60000
COPY_SHADOW_TRADE_SIZE_USD=25
COPY_SHADOW_MAX_POSITION_USD=100
COPY_SHADOW_EXECUTION_DELAY_BLOCKS=1
COPY_SHADOW_MAX_PRICE_LOOKAHEAD_BLOCKS=120
COPY_SHADOW_SLIPPAGE_BPS=300
COPY_SHADOW_GAS_USD=0.03
COPY_SHADOW_MIN_SOURCE_VOLUME_USD=0
COPY_SHADOW_RECENT_SIGNALS_LIMIT=200
COPY_SHADOW_POSITION_LIMIT=200

# Optional Blockscout PRO API key. Telegram /watch and /scan pool discovery,
# v4 /pool id lookup, contract-creator lookups, wallet-PnL pool bootstraps,
# and optional archive swap-log ingestion use this when set.
# disabled: never use it; fallback: use it only if RPC log fetch fails;
# preferred: use it first for archive swap logs, then fall back to RPC on errors.
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_API_BASE_URL=https://api.blockscout.com/v2/api
BLOCKSCOUT_LOG_SOURCE=disabled
BLOCKSCOUT_LOG_CHUNK_SIZE=5000
BLOCKSCOUT_MAX_LOGS_PER_REQUEST=1000
# All Blockscout HTTP calls share one serialized in-process queue, so these
# limits apply across contract-creator, historical-transfer, token-bootstrap,
# pool-discovery, and log lookups.
BLOCKSCOUT_MAX_REQUESTS_PER_TICK=60
BLOCKSCOUT_REQUEST_DELAY_MS=1000
# Optional Worker origin for browser-facing market reads.
PUBLIC_MARKET_API_BASE=

# Bounded one-shot archive sizing/writes. Use --dry-run by default; use --write
# only when R2 credentials are configured and you want actual R2 objects.
MARKET_BACKFILL_CHAIN=base
MARKET_BACKFILL_LOOKBACK_BLOCKS=2400
MARKET_BACKFILL_MAX_POOLS=12
MARKET_BACKFILL_TIMEOUT_MS=110000

LIVE_SMOKE_GLOBAL_TIMEOUT_MS=120000
LIVE_SMOKE_CASE_TIMEOUT_MS=20000
LIVE_SMOKE_LOOKBACK_BLOCKS=50000
LIVE_SMOKE_CONCURRENCY=3
LIVE_SMOKE_LOG_CHUNK=500
LIVE_SMOKE_MIN_LOG_CHUNK=5
LIVE_SMOKE_HEAD_LAG_BLOCKS=8

# =============================================================================
# Pricing
# =============================================================================

ETH_USD_OVERRIDE=
DISABLE_COINGECKO=false
# Dexscreener supplies market cap/FDV for buy alerts and USD prices for quote tokens
# that are neither stablecoins nor the chain's native asset (e.g. SOUN on Robinhood Chain).
DISABLE_DEXSCREENER=false

LOG_LEVEL=info
